{
    "name": "fort/fast-short",
    "description": "FORT (Fast Short) - Enterprise-Grade Open-Source URL Shortener",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.10",
        "bacon/bacon-qr-code": "^3.0",
        "phpmailer/phpmailer": "^6.9",
        "monolog/monolog": "^3.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=PSR12 app/",
        "test": "phpunit tests/",
        "migrate": "php database/migrate.php"
    },
    "config": {
        "audit": {
            "ignore": ["PKSA-y2cr-5h3j-g3ys"]
        }
    }
}
