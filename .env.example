# FORT (Fast Short) - Configuration
# Copy this file to .env and adjust values

# --- Application ---
APP_NAME="FORT (Fast Short)"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=

# --- Database ---
# Driver: pgsql or sqlite
DB_DRIVER=sqlite
# For SQLite:
DB_SQLITE_PATH=storage/fort.sqlite
# For PostgreSQL:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fort
DB_USER=fort
DB_PASSWORD=secret

# --- Session ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_HTTPS_ONLY=false

# --- Mail (SMTP for email verification, password reset, invites) ---
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="FORT (Fast Short)"

# --- Rate Limiting ---
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_LOGIN=10
RATE_LIMIT_CREATE_LINK=30
RATE_LIMIT_API=60

# --- Security ---
CORS_ALLOWED_ORIGINS=*
SESSION_SECURE_COOKIE=false
TRUSTED_PROXIES=

# --- 2FA ---
FEATURE_TWOFA=false
TOTP_ISSUER="FORT (Fast Short)"

# --- Feature Toggles ---
FEATURE_EMAIL_VERIFICATION=false
FEATURE_GEOLOCATION=false
FEATURE_SAFE_BROWSING=false
FEATURE_WEBHOOKS=false
FEATURE_LINK_CLOAKING=false

# --- Google Safe Browsing (requires FEATURE_SAFE_BROWSING=true) ---
SAFE_BROWSING_API_KEY=

# --- Cron / Cleanup ---
CLEANUP_EXPIRED_LINKS_DAYS=30
PURGE_AUDIT_LOGS_DAYS=365
PURGE_UNVERIFIED_USERS_DAYS=7
